{
  "info": {
    "_postman_id": "6f1c2a8e-3b4d-4e5f-9a10-catalogo0u10",
    "name": "API Catálogo de Productos",
    "description": "Pruebas de extremo a extremo contra la aplicación catalogo-productos en ejecución local (H2 real, sin mocks).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta contiene id numérico\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.have.property(\"id\");",
              "    pm.expect(b.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"productoId\", b.id);",
              "});",
              "pm.test(\"Tiempo de respuesta < 500ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 120.0,\n  \"categoria\": \"ELECTRONICA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        }
      }
    },
    {
      "name": "GET Obtener producto por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"El nombre coincide con el creado\", () => {",
              "    pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "{{productoId}}"]
        }
      }
    },
    {
      "name": "GET Listar productos por categoría",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La lista contiene el producto creado\", () => {",
              "    const lista = pm.response.json();",
              "    pm.expect(lista).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(lista.map(p => p.nombre)).to.include(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"],
          "query": [
            { "key": "categoria", "value": "ELECTRONICA" }
          ]
        }
      }
    },
    {
      "name": "GET Producto inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"El cuerpo indica que no se encontró\", () => {",
              "    pm.expect(pm.response.text()).to.include(\"Producto no encontrado\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/99999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "99999"]
        }
      }
    }
  ],
  "variable": [
    { "key": "productoId", "value": "" }
  ]
}
